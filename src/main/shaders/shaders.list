# Shaders of the Stein graphics API: one source (Vulkan-style GLSL) -> SPIR-V -> OpenGL GLSL (tools/ShaderBuild.java).
# output            stage    source                 definitions
entity.vert         vert     entity.vert
entity.frag         frag     entity.frag
entity_gametex.frag frag     entity.frag           GAME_TEX
entity_glint.vert   vert     entity.vert           GLINT2
entity_glint.frag   frag     entity.frag           GLINT2
entity_dynamic.vert vert     entity_dynamic.vert
entity_dynamic.frag frag     entity_dynamic.frag
entity_text.vert    vert     entity_dynamic.vert   TEXT
terrain.vert        vert     terrain.vert
terrain.frag        frag     terrain.frag
terrain_alpha.frag  frag     terrain.frag          ALPHA_TEST
terrain_inv.vert    vert     terrain.vert          INVARIANT
terrain_depth.frag  frag     terrain.frag          DEPTH_ONLY
# the LENS variants (SteinLensLight): the Lens's light; the ones above are the game's pixel at the game's cost
entity_lens.vert          vert     entity.vert           LENS
entity_lens.frag          frag     entity.frag           LENS
entity_gametex_lens.frag  frag     entity.frag           GAME_TEX LENS
entity_dynamic_lens.vert  vert     entity_dynamic.vert   LENS
entity_dynamic_lens.frag  frag     entity_dynamic.frag   LENS
entity_text_lens.vert     vert     entity_dynamic.vert   TEXT LENS
terrain_lens.vert         vert     terrain.vert          LENS
terrain_lens.frag         frag     terrain.frag          LENS
terrain_alpha_lens.frag   frag     terrain.frag          ALPHA_TEST LENS
terrain_lens_gbuf.frag    frag     terrain.frag          LENS GBUFFER
terrain_alpha_lens_gbuf.frag frag  terrain.frag          ALPHA_TEST LENS GBUFFER
ray_light.frag            frag     ray_light.frag        RT
ray_gi.frag               frag     ray_gi.frag           RT
terrain_water.vert        vert     terrain.vert          LENS WATER
terrain_water.frag        frag     terrain.frag          LENS WATER RT
terrain_inv_lens.vert     vert     terrain.vert          INVARIANT LENS
pose.comp           comp     pose.comp
gather.comp         comp     gather.comp
selftest.vert       vert     selftest.vert
selftest.frag       frag     selftest.frag
selftest.comp       comp     selftest.comp
blue.vert           vert     fullscreen_blue.vert
blue.frag           frag     fullscreen_blue.frag
post.vert             vert     post.vert
post_bloom_first.frag frag     post_bloom_down.frag  FIRST
post_bloom_down.frag  frag     post_bloom_down.frag
post_bloom_up.frag    frag     post_bloom_up.frag
post_composite.frag   frag     post_composite.frag
post_composite_hdr.frag frag   post_composite.frag   HDR_LAYER
post_luma.frag        frag     post_luma.frag
post_adapt.frag       frag     post_adapt.frag
post_rays.frag        frag     post_rays.frag
post_ao.frag          frag     post_ao.frag
post_ao_apply.frag    frag     post_ao_apply.frag
sky_dome.frag         frag     sky_dome.frag
loading.frag          frag     loading.frag
shadow_cast.frag      frag     shadow_cast.frag
shadow_cast.vert      vert     terrain.vert          SHADOW_CAST
entity_cast.frag      frag     entity_cast.frag
entity_cast_gametex.frag frag  entity_cast.frag      GAME_TEX
hdr_encode.frag       frag     hdr_encode.frag
