key.categories.steinlens=Lens
key.steinlens.zoom=Zoom
steinlens.button=Lens...
steinlens.dynamicFov=FOV dinámico
steinlens.dynamicFov.hint=Cambia el campo de visión al correr, con el efecto Velocidad y al tensar el arco
steinlens.zoom=Zoom
steinlens.zoom.hint=Mantén %s para hacer zoom (cambia la tecla en Controles > Lens)
steinlens.zoomSmooth=Cámara suave en el zoom
steinlens.zoomSmooth.hint=Activa la cámara suave mientras el zoom está activo
steinlens.customItems=Texturas por encantamiento
steinlens.customItems.hint=Texturas de objetos y armaduras por encantamiento, del paquete de recursos: %s regla(s)
steinlens.glint=Brillo
steinlens.glint.near=Solo cerca
steinlens.glint.hint=Brillo de encantamiento. Solo cerca: sin brillo en armaduras y objetos a más de %s bloques; en tu mano y en el inventario, siempre
steinlens.armor=Armaduras
steinlens.armor.shown=Visibles
steinlens.armor.hidden=Ocultas
steinlens.armor.hint=Oculta las armaduras de jugadores y mobs, incluida la tuya
steinlens.nametags=Nombres
steinlens.nametags.default=Normal
steinlens.nametags.blocks=%s bloques
steinlens.nametags.hint=Hasta qué distancia se ven los nombres sobre jugadores y mobs (normal del juego: 64 bloques)
steinlens.default=Normal
steinlens.compactAngles=Ángulos compactos
steinlens.compactAngles.hint=Seno y coseno de las animaciones de una tabla 16 veces menor, que cabe en la caché del procesador; animaciones un poco menos precisas
steinlens.fog=Niebla
steinlens.fog.light=Ligera
steinlens.fog.hint=Niebla de distancia del terreno. Ligera: solo en el borde de la distancia de renderizado. Agua, lava y ceguera no cambian
steinlens.cloudHeight=Altura de las nubes
steinlens.cloudHeight.blocks=+%s bloques
steinlens.cloudHeight.hint=Sube la capa de nubes por encima de la altura del juego (128)
steinlens.keep=Distancia extendida
steinlens.keep.memory=Memoria
steinlens.keep.disk=Disco
steinlens.keep.hint=Los chunks que el servidor descarta siguen en pantalla hasta tu distancia de renderizado. Disco: guardados por servidor y mundo, vuelven en la próxima visita (los lejanos son una imagen fija). Cambiar de mundo vacía la memoria
steinlens.keepLimit=Límite de espacio
steinlens.keepLimit.hint=Cuánto terreno guardar, en memoria y en disco; al superar el límite, se elimina primero lo más lejano (memoria) y lo más antiguo (disco)
steinlens.connectedTextures=Bloques conectados
steinlens.connectedTextures.hint=Texturas conectadas del paquete de recursos (vidrio, estanterías...): %s regla(s)
steinlens.chunkUploads=Chunks por cuadro
steinlens.chunkUploads.hint=Cuántos chunks listos van a la tarjeta gráfica por cuadro. Con límite, la llegada de muchos chunks se reparte en más cuadros: el terreno aparece más despacio, sin tirones
steinlens.waitNeighbors=Esperar vecinos
steinlens.waitNeighbors.hint=Solo construye un chunk cuando llegaron los 8 de alrededor: una construcción por chunk en vez de 3 a 5. El último anillo de chunks cargados no se muestra
steinlens.directRender=Dibujo directo
steinlens.directRender.hint=Dibuja directo en la ventana, sin copiar la imagen intermedia del juego en cada cuadro. Desactiva los shaders de espectador y de F4
steinlens.graphicsApi=API
steinlens.graphicsApi.hint=API gráfica en uso. Se elige en los ajustes del Stein Client, antes de abrir el juego; Vulkan es experimental
steinlens.graphicsApi.unavailable=Vulkan no se inició en este equipo (%s), así que el juego usa OpenGL
steinlens.graphicsApi.reason.no_driver=sin controlador de Vulkan
steinlens.graphicsApi.reason.no_window=el sistema de ventanas rechazó Vulkan
steinlens.graphicsApi.reason.no_device=sin tarjeta gráfica con Vulkan 1.2
steinlens.graphicsApi.crashed=La última vez que el juego se abrió con Vulkan se cerró antes de mostrarse, así que volvió a OpenGL. Elige Vulkan otra vez en el Stein Client para volver a intentarlo
steinlens.graphics=Gráficos
steinlens.graphics.fast=Rápido
steinlens.graphics.fancy=Detallado

# Temas de la pantalla de video
steinlens.topic.general=General
steinlens.topic.camera=Cámara
steinlens.topic.light=Luz y sombras
steinlens.topic.image=Imagen
steinlens.bloom=Resplandor
steinlens.bloom.low=Bajo
steinlens.bloom.high=Alto
steinlens.bloom.hint=Un brillo suave alrededor de las partes más claras del mundo (cielo cerca del sol, antorchas, lava). El HUD y los menús no cambian
steinlens.smoothEdges=Bordes suaves
steinlens.smoothEdges.hint=Suaviza los dientes de sierra en el contorno de bloques, jugadores y objetos contra lo que hay detrás. Las texturas siguen nítidas
steinlens.hdr=HDR
steinlens.hdr.hint=En una pantalla HDR, las luces (sol, antorchas, lava) brillan más que el blanco de los menús. Necesita Vulkan y el HDR activado en la configuración de pantalla de Windows
steinlens.hdrWhite=Brillo del HDR
steinlens.hdrWhite.hint=Cuánto brilla el blanco de los menús y del mundo de día con el HDR. Déjalo cerca del "Brillo del contenido SDR" de Windows para que los menús se vean iguales con y sin HDR
steinlens.hdrPeak=Pico de la pantalla
steinlens.hdrPeak.hint=Lo máximo que muestra tu pantalla (mira su especificación: HDR400, HDR600, HDR1000...). Las luces se acercan a él suavemente en vez de volverse un blanco plano
steinlens.nits=%s nits
steinlens.topic.sky=Cielo y clima
steinlens.topic.textures=Texturas
steinlens.topic.players=Jugadores y objetos
steinlens.topic.performance=Rendimiento
steinlens.rain=Lluvia
steinlens.rain.hint=Desactivada: el juego ya no dibuja lluvia ni nieve para ti (sin gotas, salpicaduras ni sonido de lluvia, y con el cielo despejado). El clima sigue igual para el servidor y para el resto del juego
steinlens.graphics.hint=Los modos Rápido y Detallado del juego. Cada uno también ajusta las opciones del juego: el Rápido desactiva nubes, partículas, iluminación suave y sombras y limita la distancia de renderizado a 8 chunks
steinlens.topic.animations=Animaciones 1.7
steinlens.oldAnimations=Animaciones 1.7
steinlens.oldAnimations.hint=Las animaciones de la 1.7, como el mod Old Animations, solo en tu pantalla: nada cambia en lo que va al servidor. Cada parte de abajo se puede activar por separado
steinlens.oldBlockHit=Golpe al bloquear
steinlens.oldBlockHit.hint=El golpe sigue viéndose al bloquear con la espada, comer, beber o tensar el arco; bloqueando con el ataque mantenido sobre un bloque, la mano golpea como en la 1.7 (sin minar y sin avisar al servidor)
steinlens.oldItems=Objetos en la mano
steinlens.oldItems.hint=Objetos en la mano en primera persona en la posición de la 1.7, un poco más pequeños y más bajos. Los bloques no cambian
steinlens.oldSwordBlock=Bloqueo con espada
steinlens.oldSwordBlock.hint=La espada bloqueando en primera persona en la posición de la 1.7
steinlens.oldBow=Arco
steinlens.oldBow.hint=El arco en primera persona en la posición de la 1.7, quieto y tensado
steinlens.oldRod=Caña de pescar
steinlens.oldRod.hint=La caña de pescar (y la zanahoria con palo) en primera persona en la posición de la 1.7
steinlens.oldBlockPose=Bloqueo en 3ª persona
steinlens.oldBlockPose.hint=Jugadores bloqueando con el brazo y la espada de la 1.7: el brazo sin el giro hacia dentro y la espada cruzada delante del cuerpo
steinlens.oldArmorHurt=Daño en la armadura
steinlens.oldArmorHurt.hint=La armadura se pone roja junto con el cuerpo cuando el jugador o el mob recibe daño, como en la 1.7
