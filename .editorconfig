root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,glsl,vert,frag,comp}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{sh,gradle,yml,json,md}]
indent_style = space
indent_size = 2

[*.tsv]
indent_style = tab

[*.bat]
end_of_line = crlf
